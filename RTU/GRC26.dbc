 SG_ GPS_Course : 16|16@1+ (0.01,0) [0|655.35] "deg" RemoteLogger

CM_ BU_ MaxxECU "Vendor protocol v1.3; selected signals match CAN_Signal_Checklist(1).xlsx On car selections.";
CM_ BO_ 1336 "User_Channel_1 must be named to its actual MTune assignment before vehicle use.";
CM_ BO_ 1536 "DLVR-L30D-E1BD differential-pressure telemetry.";
CM_ BO_ 1537 "BME680 ambient-temperature and pressure telemetry.";
CM_ BO_ 1538 "NodeState: 0=boot, 1=healthy, 2=degraded, 3=fault. SensorFlags and FaultFlags are node-owned bitmasks.";
CM_ BO_ 1554 "NodeState: 0=boot, 1=healthy, 2=degraded, 3=fault. SensorFlags and FaultFlags are node-owned bitmasks.";

VAL_ 1538 AeroProbe_NodeState 0 "Boot" 1 "Healthy" 2 "Degraded" 3 "Fault";
VAL_ 1554 ImuGps_NodeState 0 "Boot" 1 "Healthy" 2 "Degraded" 3 "Fault";
